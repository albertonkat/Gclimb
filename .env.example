# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Nymble EMR
NYMBLE_BASE_URL=https://api.nymble.com/v1
NYMBLE_API_KEY=
NYMBLE_PRACTICE_ID=

# EzClaim
EZCLAIM_BASE_URL=https://api.ezclaim.com/v2
EZCLAIM_API_KEY=
EZCLAIM_ACCOUNT_ID=

# Redis (job queue)
REDIS_URL=redis://localhost:6379/0

# Storage
UPLOAD_DIR=/tmp/gclimb_uploads
MAX_PDF_SIZE_MB=32

# Security
HMAC_SECRET=change-me-in-production
AUDIT_LOG_PATH=/var/log/gclimb/audit.jsonl

# Feature flags
ENABLE_HUMAN_REVIEW_QUEUE=true
CONFIDENCE_THRESHOLD=0.85
